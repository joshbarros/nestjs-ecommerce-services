{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "api-gateway",
        "auth-service",
        "user-service",
        "catalog-service",
        "cart-service",
        "order-service",
        "payment-service",
        "inventory-service",
        "shipping-service",
        "notification-service",
        "shared",
        "database",
        "messaging",
        "infrastructure",
        "docs"
      ]
    ],
    "subject-case": [2, "never", ["upper-case"]],
    "header-max-length": [2, "always", 100]
  }
}
